# Leave empty for offline commands. A real value is required only when
# RUN_LIVE_UPSTAGE_TESTS=1.
UPSTAGE_API_KEY=
RUN_LIVE_UPSTAGE_TESTS=0
ALLOW_GOLD_ACCESS=0

DATABASE_URL=postgresql+asyncpg://ragbench:ragbench@localhost:5433/ragbench_test
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
MAX_PROJECT_BUDGET_USD=135.00
MAX_CONCURRENCY=5
# Dedicated PostgreSQL advisory-lock sessions are unpooled but process-bounded.
MAX_LOCK_CONNECTIONS=2
MAX_RETRIES=5
CACHE_DIR=.ragbench/cache
DATA_DIR=data
UPSTAGE_SOLAR_PRO3_MODEL_ID=solar-pro3
UPSTAGE_SOLAR_PRO4_MODEL_ID=solar-pro4
UPSTAGE_EMBEDDING_MODEL_ID=embedding-query
UPSTAGE_DOCUMENT_PARSE_MODEL_ID=document-parse
UPSTAGE_EMBED_2_PROMOTION_ENDS_AT=2026-08-23T00:00:00+00:00
